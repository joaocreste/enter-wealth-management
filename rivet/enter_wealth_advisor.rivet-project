    g_market:
      metadata:
        description: Prices every position through the approved provider chain and
          records the source of each figure.
        id: g_market
        name: 02 · Fetch and validate market data
      nodes:
        '[code_000j_ewa]:code "Validation gate — stops the run"':
          data:
            allowConsole: true
            allowFetch: false
            allowProcess: false
            allowRequire: false
            allowRivet: false
            code: >-
              // Stops the run before a client ever sees a figure that failed
              validation.

              // An unavailable position is acceptable and is disclosed in the
              letter; a

              // failed price sanity check is not, so this throws rather than
              reporting a

              // verdict nothing downstream is obliged to read.

              const r = inputs.result.value;

              const failed = (r.review || []).filter((v) => v.status ===
              'fail');

              if (failed.length) {
                throw new Error(`stage 02: ${failed.length} position(s) failed price validation — ${failed.map((f) => f.symbol || f.position_id).join(', ')}`);
              }

              return { market: { type: 'object', value: r } };
            inputNames:
              - result
            outputNames:
              - market
          outgoingConnections:
            - market->"market_data" graphOutput_000k_ewa/value
          visualData: 1880/158/440/null//
        '[comment_000b_ewa]:comment "STAGE 02 — MARKET DATA AND VALIDATION"':
          data:
            backgroundColor: rgba(0,0,0,0.05)
            color:
              bg: "#1F2427"
              border: "#2E3439"
            height: 600
            text: >-
              STAGE 02 — MARKET DATA AND VALIDATION


              Prices every position at both ends of the reporting month through
              the provider chain:
                · listed instruments  → Yahoo Finance, falling back to the TradingView last close
                · fund quotas         → the custodian statement (no public feed exists)
                · contractual paper   → accrued from the Banco Central index plus the contract spread
                · FX                  → PTAX from the Banco Central

              A position that cannot be valued is reported as DATA UNAVAILABLE
              with the providers tried.

              It is never estimated, and it contributes exactly zero to the
              return (§30).
          visualData: 40/40/520/null//
