    g_signals:
      metadata:
        description: Captures the two signal families independently and flags where they
          disagree.
        id: g_signals
        name: 05 · TradingView technical and analyst signals
      nodes:
        '[code_001j_ewa]:code "Separate the two families"':
          data:
            allowConsole: true
            allowFetch: false
            allowProcess: false
            allowRequire: false
            allowRivet: false
            code: >-
              // A technical Sell alongside an analyst Strong Buy is a real
              disagreement and

              // is exactly what the advisor should be talking about. It is
              surfaced, never

              // averaged away.

              const r = inputs.result.value;

              const score = { 'Strong Buy': 2, Buy: 1, Neutral: 0, Sell: -1,
              'Strong Sell': -2 };

              const conflicts = (r.rows || []).filter((row) => {
                const t = score[row.technical], a = score[row.analyst];
                return t != null && a != null && Math.sign(t) !== 0 && Math.sign(a) !== 0 && Math.sign(t) !== Math.sign(a);
              });

              return {
                signals: { type: 'object', value: r },
                conflicts: { type: 'object[]', value: conflicts.map((c) => ({ type: 'object', value: c })) },
              };
            inputNames:
              - result
            outputNames:
              - signals
              - conflicts
          outgoingConnections:
            - conflicts->"signal_conflicts" graphOutput_001l_ewa/value
            - signals->"signals" graphOutput_001k_ewa/value
