# Word and PowerPoint write a lock file beside every open document. They are
# empty owner stubs that vanish when the document closes; committing one just
# records who had the file open on some afternoon.
~$*

# Third-party material from the working session. Kept locally, deliberately not
# published: brand-guidelines.html is XP's brand system, extracted from XP
# Advisory's own reports, and Input/ holds XP's case files including XP
# Research's macro report. Nothing in src/ or worker/ reads them at runtime —
# the brand tokens live in src/core/brand.js and the case data is reproduced
# in seed/.
brand-guidelines.html
README.md.docx
Input/
Output/
enter_challenge.rivet-project

# Cloudflare API token, when the OAuth browser flow is not usable.
# Read by scripts/cloudflare-auth.mjs; never committed.
.cloudflare-token

# Your copy of the deployed Worker secrets.
.secrets.local

# Python bytecode from the deck builder.
__pycache__/
*.pyc
