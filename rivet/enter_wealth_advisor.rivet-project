    g_assemble:
      metadata:
        description: Builds and validates the single payload that every output format
          renders from.
        id: g_assemble
        name: 08 · Assemble the canonical report
      nodes:
        '[code_002n_ewa]:code "Publication gate — stops the run"':
          data:
            allowConsole: true
            allowFetch: false
            allowProcess: false
            allowRequire: false
            allowRivet: false
            code: >-
              // "pending advisor approval" is not an error, it is the design:
              the advisor

              // gate at stage 09 is the whole point, so it travels on as a
              count for the

              // orchestrator to report. A blocking error is anything else, and
              there is no

              // letter to be had from a report that carries one.

              const r = inputs.result.value;

              const blocking = r.blocking_errors || [];

              if (blocking.length) throw new Error(`stage 08: ${blocking.length}
              blocking error(s) — ${blocking.join(' | ')}`);

              return {
                report: { type: 'object', value: r },
                pending_approval: { type: 'number', value: r.pending_advisor_approval || 0 },
              };
            inputNames:
              - result
            outputNames:
              - report
              - pending_approval
          outgoingConnections:
            - pending_approval->"pending_approval" graphOutput_002p_ewa/value
            - report->"canonical_report" graphOutput_002o_ewa/value
          visualData: 1880/232/460/null//
        '[comment_002e_ewa]:comment "STAGE 08 — CANONICAL REPORT ASSEMBLY AND VALIDATION"':
          data:
            backgroundColor: rgba(0,0,0,0.05)
            color:
              bg: "#1F2427"
              border: "#2E3439"
            height: 600
            text: >-
              STAGE 08 — CANONICAL REPORT ASSEMBLY AND VALIDATION


              Builds the single structured payload that the HTML email, the PDF
              and the client portal

              all render from, then validates it:

                · every market figure carries a source id that exists in the source ledger
                · analyst sentiment was never inferred from a technical rating
                · absolute P&L reconciles with market values and flows
                · attribution sums to the reported return
                · nothing reaches a client that the advisor has not approved (§23)
          visualData: 40/40/520/null//
        '[graphInput_002f_ewa]:graphInput "run_id"':
          data:
            dataType: string
            id: run_id
            useDefaultValueInput: false
          outgoingConnections:
